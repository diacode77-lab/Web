using Microsoft.AspNetCore.Mvc;
using Crud.Services;

public class CuentaController : Controller
{
    private readonly SesionService _sesionService;

    public CuentaController(SesionService sesionService)
    {
        _sesionService = sesionService;
    }

    // Ruta: /Cuenta/Login
    public async Task<IActionResult> Login()
    {
        var datos = new DatosSesion
        {
            Usuario = "juanperez",
            Token = Guid.NewGuid().ToString()
        };

        string idSesion = await _sesionService.CrearSesionAsync(datos, TimeSpan.FromMinutes(30));

        Response.Cookies.Append(_sesionService.NombreCookie, idSesion, new CookieOptions
        {
            HttpOnly = true,
            Secure = true,
            SameSite = SameSiteMode.Strict,
            Expires = DateTimeOffset.UtcNow.AddMinutes(30)
        });

        return Content("Sesión iniciada. Ahora navega a /Cuenta/Perfil");
    }

    // Ruta: /Cuenta/Perfil
    public async Task<IActionResult> Perfil()
    {
        string? idSesion = Request.Cookies[_sesionService.NombreCookie];

        if (idSesion == null)
        {
            return Content("No hay cookie de sesión. Debes hacer login primero.");
        }

        var datos = await _sesionService.ObtenerSesionAsync(idSesion);

        if (datos == null)
        {
            return Content("La sesión expiró o no existe.");
        }

        return Content($"Usuario logueado: {datos.Usuario} | Token: {datos.Token}");
    }

    // Ruta: /Cuenta/Logout
    public async Task<IActionResult> Logout()
    {
        string? idSesion = Request.Cookies[_sesionService.NombreCookie];

        if (idSesion != null)
        {
            await _sesionService.CerrarSesionAsync(idSesion);
            Response.Cookies.Delete(_sesionService.NombreCookie);
        }

        return Content("Sesión cerrada.");
    }
}
