namespace Crud.Services;

using Microsoft.Extensions.Caching.Memory;

public class DatosSesion
{
    public string Usuario { get; set; } = "";
    public string Token { get; set; } = "";
}

public class SesionService
{
    private readonly IMemoryCache _cache;
    private const string NOMBRE_COOKIE = "sesion_id";

    public SesionService(IMemoryCache cache)
    {
        _cache = cache;
    }

    /// <summary>
    /// Crea una nueva sesión: genera un id único, lo guarda como
    /// clave en IMemoryCache junto a los datos de sesión, y
    /// devuelve el id para que el Controller lo escriba como cookie.
    /// </summary>
    public string CrearSesion(DatosSesion datos, TimeSpan duracion)
    {
        string idSesion = Guid.NewGuid().ToString();

        _cache.Set(idSesion, datos, duracion);

        return idSesion;
    }

    /// <summary>
    /// Busca los datos de sesión asociados a un id
    /// (el valor que viene de la cookie del navegador).
    /// </summary>
    public DatosSesion? ObtenerSesion(string idSesion)
    {
        if (_cache.TryGetValue(idSesion, out DatosSesion? datos))
        {
            return datos;
        }
        return null;
    }

    /// <summary>
    /// Elimina la sesión (logout).
    /// </summary>
    public void CerrarSesion(string idSesion)
    {
        _cache.Remove(idSesion);
    }

    public string NombreCookie => NOMBRE_COOKIE;
}
