namespace Crud.Services;

using Microsoft.Extensions.Caching.Distributed;
using System.Text.Json;

public class DatosSesion
{
    public string Usuario { get; set; } = "";
    public string Token { get; set; } = "";
}

public class SesionService
{
    private readonly IDistributedCache _cache;
    private const string NOMBRE_COOKIE = "sesion_id";

    public SesionService(IDistributedCache cache)
    {
        _cache = cache;
    }

    /// <summary>
    /// Crea una nueva sesión: genera un id único, serializa los
    /// datos a JSON y los guarda en el caché distribuido (Redis).
    /// </summary>
    public async Task<string> CrearSesionAsync(DatosSesion datos, TimeSpan duracion)
    {
        string idSesion = Guid.NewGuid().ToString();

        string json = JsonSerializer.Serialize(datos);

        var opciones = new DistributedCacheEntryOptions
        {
            AbsoluteExpirationRelativeToNow = duracion
        };

        await _cache.SetStringAsync(idSesion, json, opciones);

        return idSesion;
    }

    /// <summary>
    /// Busca y deserializa los datos de sesión asociados a un id.
    /// </summary>
    public async Task<DatosSesion?> ObtenerSesionAsync(string idSesion)
    {
        string? json = await _cache.GetStringAsync(idSesion);

        if (json == null)
        {
            return null;
        }

        return JsonSerializer.Deserialize<DatosSesion>(json);
    }

    /// <summary>
    /// Elimina la sesión (logout).
    /// </summary>
    public async Task CerrarSesionAsync(string idSesion)
    {
        await _cache.RemoveAsync(idSesion);
    }

    public string NombreCookie => NOMBRE_COOKIE;
}
